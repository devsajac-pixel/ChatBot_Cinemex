# TELEGRAM
BOT_TOKEN=

# Números de teléfono autorizados (separados por comas, con o sin código de país)
ALLOWED_PHONES=

# Robot de UIPATH
UIROBOT_EXE=

# Carpeta raíz donde están los proyectos UiPath (subcarpetas con project.json)
RPA_FOLDER=

# Argumentos extra para UiRobot.exe
UIROBOT_ARGS=execute --file

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/bot.txt
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Palabras clave que disparan el menú (separadas por comas, sin espacios)
MENU_KEYWORDS=menu,menú,bots,robots,procesos,lista,inicio,ayuda,help

# Máximo de procesos en cola
MAX_QUEUE_SIZE=10

FUZZY_THRESHOLD=90

# IDs de chat de Telegram del equipo de soporte (separados por comas)
# Se notificarán automáticamente cuando un RPA falle
# Ejemplo: SUPPORT_CHAT_IDS=123456789,987654321
SUPPORT_CHAT_IDS=